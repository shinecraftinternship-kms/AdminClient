{
  // ── Python Language Server & Diagnostics ──────────────────────────────
  "pyrefly.enable": false,
  "pyrefly.diagnostics.enable": false,
  "pyrefly.lint.enable": false,
  "pyrefly.typeCheckingMode": "off",

  // Use Pylance for error-free Python intelligence
  "python.languageServer": "Pylance",
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.extraPaths": [
    "./admin"
  ],

  // Silence Pylance false positive on urllib3.__version__ (requests dep)
  "python.analysis.diagnosticSeverityOverrides": {
    "reportPrivateImportUsage": "none"
  },

  "editor.formatOnSave": false,
  "files.trimTrailingWhitespace": true
}
